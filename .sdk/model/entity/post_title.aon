# Entity: post_title

main: kit: entity: post_title: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      short: "The author of the content post"
      type: "`$STRING`"
    }
    {
      name: "categories"
      req: false
      short: "Content types and language code"
      type: "`$ARRAY`"
    }
    {
      name: "content"
      req: false
      short: "The HTML body content of the post"
      type: "`$STRING`"
    }
    {
      name: "date"
      req: false
      short: "The publication or last modified date"
      type: "`$STRING`"
    }
    {
      name: "lang"
      req: false
      short: "Language code: 'en' for English, 'es' for Spanish"
      type: "`$STRING`"
    }
    {
      name: "layout"
      req: false
      short: "The layout used to display the content"
      type: "`$STRING`"
    }
    {
      name: "order"
      req: false
      short: "Contextual position of the content"
      type: "`$INTEGER`"
    }
    {
      name: "tags"
      req: false
      short: "An array of content tags, such as 'promote'"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "The title of the content post"
      type: "`$STRING`"
    }
    {
      name: "topics"
      req: false
      short: "Associated topics (for articles)"
      type: "`$ARRAY`"
    }
    {
      name: "url"
      req: false
      short: "The URL path to the content post"
      type: "`$STRING`"
    }
  ]

  name: "post_title"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: "accessibility"
                kind: "param"
                name: "post_title"
                orig: "post_title"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "callback"
                orig: "callback"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/{post-title}.json"
          segments: [
            {
              lit: "{post-title}.json"
            }
          ]
          select: {
            exist: [
              "callback"
              "post_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

# Entity: index

main: kit: entity: index: {

  alias: field: {}

  fields: [
    {
      name: "bite"
      req: false
      short: "A short summary of the post"
      type: "`$STRING`"
    }
    {
      name: "categories"
      req: false
      short: "Content types and language code"
      type: "`$ARRAY`"
    }
    {
      name: "esbite"
      req: false
      short: "The post summary in Spanish"
      type: "`$STRING`"
    }
    {
      name: "estitle"
      req: false
      short: "Spanish translation of the post's title"
      type: "`$STRING`"
    }
    {
      name: "state"
      req: false
      short: "Associated states for the post"
      type: "`$ARRAY`"
    }
    {
      name: "tags"
      req: false
      short: "An array of content tags, such as 'promote'"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "The post's title"
      type: "`$STRING`"
    }
    {
      name: "topics"
      req: false
      short: "Associated topics (for articles)"
      type: "`$ARRAY`"
    }
    {
      name: "url"
      req: false
      short: "URL to the HTML version of the post (add .json for post object)"
      type: "`$STRING`"
    }
  ]

  name: "index"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "callback"
                orig: "callback"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/index.json"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "index.json"
            }
          ]
          select: {
            exist: [
              "callback"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
